# 複製此檔為 .env.local 並填入以下值

# Resend API Key（Vercel 部署時請在 Environment Variables 設定）
RESEND_API_KEY=

# Cloudflare Turnstile（選用，建議正式環境啟用以加強防垃圾）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Apps Script（選用，若仍使用 /api/inquiry）
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/xxxxx/exec
GOOGLE_SCRIPT_SECRET=change-this-secret-key
